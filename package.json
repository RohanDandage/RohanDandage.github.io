{
  "name": "rohan-dandage-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -i src/tailwind.css -o css/tailwind.css --watch",
    "dev": "npm run build:css && tsx server.ts",
    "build": "npm run clean && npm run build:css && mkdir -p dist && cp -r assets css js index.html robots.txt sitemap.xml .nojekyll dist/ && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node dist/server.cjs",
    "clean": "rm -rf dist css",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
